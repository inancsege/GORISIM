# Hugging Face access token — REQUIRED for pyannote 3.1.
# Create at https://huggingface.co/settings/tokens
# Then accept terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Optional: only needed if GORISIM_USE_LLM=true
OPENAI_API_KEY=

# auto | cpu | mps | cuda
GORISIM_DEVICE=auto

# on | off
GORISIM_DIARIZATION=on

# true | false
GORISIM_USE_LLM=false

# speaker_zero | all
GORISIM_NO_PROFILE_MODE=speaker_zero

GORISIM_WHISPER_MODEL=large-v3-turbo

GORISIM_MAX_VIDEO_MB=100
GORISIM_MAX_VIDEO_SECONDS=30
GORISIM_MAX_AUDIO_MB=50
GORISIM_MAX_AUDIO_SECONDS=120

GORISIM_MODELS_DIR=./models
GORISIM_DATA_DIR=./data

GORISIM_CLIP_TTL_SECONDS=3600
